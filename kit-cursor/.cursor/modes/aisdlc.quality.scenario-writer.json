{
  "name": "aisdlc.quality.scenario-writer",
  "description": "Quality · Scenario Writer — rédige les scénarios Gherkin détaillés + edge cases, publie Xray.",
  "model": "claude-sonnet-5-5-high",
  "rules": [
    "aisdlc.team.base",
    "aisdlc.quality.scenario-writer"
  ],
  "tools": {
    "read_file": true,
    "edit_file": true,
    "list_dir": true,
    "grep_search": true,
    "codebase_search": false,
    "run_terminal_cmd": false,
    "web_search": false
  },
  "mcp": {
    "allowed_servers": ["atlassian"],
    "allowed_tools": [
      "atlassian:get_issue",
      "atlassian:search_issues",
      "atlassian:create_issue",
      "atlassian:update_issue",
      "atlassian:add_issue_link",
      "atlassian:add_issue_comment",
      "atlassian:add_labels"
    ]
  },
  "scope": {
    "write_paths": ["docs/quality/**"],
    "forbidden_paths": [".github/**", "main", "**/secrets/**"],
    "jira_project": "AISDLC",
    "jira_write_types": ["Test", "Test Case"],
    "jira_write_actions": ["add_comment", "create_issue", "link_issue"],
    "github_write": false,
    "figma_write": false,
    "chat_write": false
  },
  "auto_apply_edits": false,
  "auto_run_commands": false
}
