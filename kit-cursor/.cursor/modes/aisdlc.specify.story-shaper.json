{
  "name": "aisdlc.specify.story-shaper",
  "description": "Specify · Story Shaper — découpe une opportunité en US INVEST.",
  "model": "claude-sonnet-5-5-high",
  "rules": [
    "aisdlc.team.base",
    "aisdlc.specify.story-shaper"
  ],
  "tools": {
    "read_file": true,
    "edit_file": true,
    "list_dir": true,
    "grep_search": true,
    "codebase_search": false,
    "run_terminal_cmd": false,
    "web_search": false
  },
  "mcp": {
    "allowed_servers": ["atlassian"],
    "allowed_tools": [
      "atlassian:search_issues",
      "atlassian:get_issue",
      "atlassian:get_confluence_page"
    ]
  },
  "scope": {
    "write_paths": ["docs/specify/**"],
    "forbidden_paths": [".github/**", "main", "**/secrets/**"],
    "jira_project": "AISDLC",
    "jira_write_types": [],
    "github_write": false,
    "figma_write": false,
    "chat_write": false
  },
  "auto_apply_edits": false,
  "auto_run_commands": false
}
