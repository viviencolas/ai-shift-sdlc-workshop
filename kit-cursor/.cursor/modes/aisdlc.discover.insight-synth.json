{
  "name": "aisdlc.discover.insight-synth",
  "description": "Discover · Insight Synth — clusterise les verbatims en pains + jobs-to-be-done.",
  "model": "claude-sonnet-5-5-high",
  "rules": [
    "aisdlc.team.base",
    "aisdlc.discover.insight-synth"
  ],
  "tools": {
    "read_file": true,
    "edit_file": true,
    "list_dir": true,
    "grep_search": true,
    "codebase_search": false,
    "run_terminal_cmd": false,
    "web_search": false
  },
  "mcp": {
    "allowed_servers": ["atlassian"],
    "allowed_tools": [
      "atlassian:get_confluence_page",
      "atlassian:search_confluence_pages"
    ]
  },
  "scope": {
    "write_paths": ["docs/discover/**"],
    "forbidden_paths": [".github/**", "main", "**/secrets/**"],
    "jira_project": "AISDLC",
    "jira_write_types": [],
    "github_write": false,
    "figma_write": false,
    "chat_write": false
  },
  "auto_apply_edits": false,
  "auto_run_commands": false
}
