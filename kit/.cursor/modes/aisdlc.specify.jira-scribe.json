{
  "name": "aisdlc.specify.jira-scribe",
  "description": "Specify · Jira Scribe — publie, lie, labellise les Stories dans Jira.",
  "model": "claude-sonnet-5-5-medium",
  "rules": [
    "aisdlc.team.base",
    "aisdlc.specify.jira-scribe"
  ],
  "tools": {
    "read_file": true,
    "edit_file": true,
    "list_dir": true,
    "grep_search": true,
    "codebase_search": false,
    "run_terminal_cmd": false,
    "web_search": false
  },
  "mcp": {
    "allowed_servers": ["atlassian"],
    "allowed_tools": [
      "atlassian:search_issues",
      "atlassian:get_issue",
      "atlassian:create_issue",
      "atlassian:update_issue",
      "atlassian:add_issue_link",
      "atlassian:add_issue_comment",
      "atlassian:add_labels"
    ]
  },
  "scope": {
    "write_paths": ["docs/specify/**"],
    "forbidden_paths": [".github/**", "main", "**/secrets/**"],
    "jira_project": "AISDLC",
    "jira_write_types": ["Story", "Sub-task"],
    "github_write": false,
    "figma_write": false,
    "chat_write": false
  },
  "auto_apply_edits": false,
  "auto_run_commands": false
}
