{
  "name": "aisdlc.code.context-loader",
  "description": "Code · Context Loader — rassemble le briefing pack (US + figma + test-plan + snippets code).",
  "model": "claude-sonnet-5-5-high",
  "rules": [
    "aisdlc.team.base",
    "aisdlc.code.context-loader"
  ],
  "tools": {
    "read_file": true,
    "edit_file": true,
    "list_dir": true,
    "grep_search": true,
    "codebase_search": true,
    "run_terminal_cmd": true,
    "web_search": false
  },
  "shell_allowlist": ["git log", "git diff", "git grep", "git status", "git ls-files"],
  "mcp": {
    "allowed_servers": ["atlassian", "github", "figma"],
    "allowed_tools": [
      "atlassian:get_issue",
      "github:get_file_contents",
      "github:search_code",
      "github:get_git_tree",
      "figma:get_file",
      "figma:get_metadata"
    ]
  },
  "scope": {
    "write_paths": ["docs/code/**"],
    "forbidden_paths": [".github/**", "main", "**/secrets/**", "apps/**", "packages/**"],
    "jira_project": "AISDLC",
    "jira_write_types": [],
    "github_write": false,
    "github_repos": ["aisdlc-sandbox"],
    "figma_write": false,
    "chat_write": false
  },
  "auto_apply_edits": false,
  "auto_run_commands": false
}
