{
  "name": "aisdlc.code.implementer",
  "description": "Code · Implementer — exécute le plan step by step (branch + commits + tests verts).",
  "model": "claude-opus-5-5-high",
  "rules": [
    "aisdlc.team.base",
    "aisdlc.code.implementer"
  ],
  "tools": {
    "read_file": true,
    "edit_file": true,
    "list_dir": true,
    "grep_search": true,
    "codebase_search": true,
    "run_terminal_cmd": true,
    "web_search": false
  },
  "shell_allowlist": [
    "pnpm install",
    "pnpm test",
    "pnpm lint",
    "pnpm build",
    "pnpm format",
    "git status",
    "git diff",
    "git log",
    "git add",
    "git commit",
    "git push",
    "git checkout",
    "git branch"
  ],
  "mcp": {
    "allowed_servers": ["github"],
    "allowed_tools": [
      "github:get_file_contents",
      "github:create_branch",
      "github:create_or_update_file"
    ]
  },
  "scope": {
    "write_paths": ["apps/**", "packages/**", "docs/code/**", "tests/**"],
    "forbidden_paths": [".github/workflows/**", "**/secrets/**"],
    "git_protected_branches": ["main"],
    "git_allowed_branch_prefix": "cursor/",
    "git_allowed_branch_suffix": "-6c26",
    "jira_project": "AISDLC",
    "jira_write_types": [],
    "jira_write_actions": ["add_comment"],
    "github_write": true,
    "github_repos": ["aisdlc-sandbox"],
    "figma_write": false,
    "chat_write": false,
    "stop_on_red_tests": true
  },
  "auto_apply_edits": false,
  "auto_run_commands": false
}
