{
  "name": "notion-like",
  "version": "0.1.0",
  "private": true,
  "description": "Application de type Notion : pages et blocs simples",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && node scripts/migrate.mjs",
    "start": "node dist/server/index.js",
    "dev": "npm run build && npm start",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
