{
  "name": "notion-like",
  "version": "0.1.0",
  "private": true,
  "description": "Application de type Notion : pages et blocs simples",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "start": "node dist/server/index.js",
    "dev": "npm run build && npm start",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:static": "tsc -p tsconfig.client.json && node scripts/build-static.mjs",
    "start:static": "npm run build:static && node scripts/serve-static.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
